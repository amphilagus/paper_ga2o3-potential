	journal = {Nano Lett.},
	author = {Azarov, Alexander and Radu, Cristian and Galeckas, Augustinas and Mercioniu, Ionel Florinel and Cernescu, Adrian and Venkatachalapathy, Vishnukanthan and Monakhov, Eduard and Djurabekova, Flyura and Ghica, Corneliu and Zhao, Junlei and Kuznetsov, Andrej},
