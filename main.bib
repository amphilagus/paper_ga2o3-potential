@article{abdullaev_thermal_2024,
  title = {Thermal Conductivity of Double Polymorph {{Ga2O3}} Structures},
  author = {Abdullaev, Azat and Sekerbayev, Kairolla and Azarov, Alexander and Venkatachalapathy, Vishnukanthan and Chauhan, Vinay S. and Utegulov, Zhandos and Kuznetsov, Andrej},
  year = 2024,
  month = aug,
  journal = {APL Mater.},
  volume = {12},
  number = {8},
  pages = {081108},
  issn = {2166-532X},
  doi = {10.1063/5.0213985},
  urldate = {2026-05-16},
  abstract = {Recently discovered double gamma/beta ({$\gamma$}/{$\beta$}) polymorph Ga2O3 structures constitute a class of novel materials providing an option to modulate functional properties across interfaces without changing the chemical compositions of materials, in contrast to that in conventional heterostructures. In this work, for the first time, we investigate thermal transport in such homo-interface structures as an example of their physical properties. In particular, the cross-plane thermal conductivity (k) was measured by femtosecond laser-based time-domain thermoreflectance with MHz modulation rates, effectively obtaining depth profiles of the thermal conductivity across the {$\gamma$}-/{$\beta$}-Ga2O3 structures. In this way, the thermal conductivity of {$\gamma$}-Ga2O3 ranging from 1.84 to 2.11~W~m-1~K-1 was found to be independent of the initial {$\beta$}-substrates orientations, in accordance with the cubic spinel structure of the {$\gamma$}-phase and consistently with the molecular dynamics simulation data. In turn, the thermal conductivity of monoclinic {$\beta$}-Ga2O3 showed a distinct anisotropy, with values ranging from 10~W~m-1~K-1 for [-201] to 20 Wm-1~K-1 for [010] orientations. Thus, for double {$\gamma$}-/{$\beta$}-Ga2O3 polymorph structures formed on [010] {$\beta$}-substrates, there is an order of magnitude difference in thermal conductivity across the {$\gamma$}/{$\beta$} interface, which can potentially be exploited in thermal energy conversion applications.},
  langid = {english},
  annotation = {Citations: 12 (Crossref) [2026-05-16]\\
Citations: 12 (SemanticScholar) [2026-05-16]}
}

@article{azarov_phase_2025,
  title = {Phase Glides and Self-Organization of Atomically Abrupt Interfaces out of Stochastic Disorder in {$\alpha$}-{{Ga2O3}}},
  author = {Azarov, Alexander and Fern{\'a}ndez, Javier Garc{\'i}a and Zhao, Junlei and He, Ru and Park, Ji-Hyeon and Jeon, Dae-Woo and Prytz, {\O}ystein and Djurabekova, Flyura and Kuznetsov, Andrej},
  year = 2025,
  month = apr,
  journal = {Nat. Commun.},
  volume = {16},
  number = {1},
  pages = {3245},
  issn = {2041-1723},
  doi = {10.1038/s41467-025-58516-9},
  urldate = {2026-05-16},
  abstract = {Abstract             Disorder-induced ordering and remarkably high radiation tolerance in {$\gamma$}-phase of gallium oxide is a recent spectacular discovery at the intersection of the fundamental physics and electronic applications. Importantly, by far, these data were collected with initial samples in form of the thermodynamically stable {$\beta$}-phase of this material. Here, we investigate these phenomena starting from metastable {$\alpha$}-phase and explain radically new trend occurring in the system. We argue that in contrast to that in {$\beta$}-to-{$\gamma$} disorder-induced transitions, the O sublattice in {$\alpha$}-phase exhibits hexagonal close-packed structure, so that to activate {$\alpha$}-to-{$\gamma$} transformation significant structural rearrangements are required in both Ga and O sublattices. Moreover, consistent with theoretical predictions, {$\alpha$}-to-{$\gamma$} phase transformation requires accumulation of the substantial tensile strain to initiate otherwise impossible lattice glides. Thus, we explain the experimentally observed trends in term of the combination of disorder and strain governed process. Finally, we demonstrate atomically abrupt {$\alpha$}/{$\gamma$} interfaces paradoxically self-organized out of the stochastic disorder.},
  langid = {english},
  annotation = {Citations: 17 (Crossref) [2026-05-16]\\
Citations: 16 (SemanticScholar) [2026-05-16]},
  file = {/Users/amphilagusgu/Zotero/storage/IBEWG7QB/Azarov 等 - 2025 - Phase glides and self-organization of atomically abrupt interfaces out of stochastic disorder in α-G.pdf}
}

@misc{galeckas_optical_2024,
  title = {Optical Library of {{Ga2O3}} Polymorphs},
  author = {Galeckas, Augustinas and Cernescu, Adrian and {Ka{\'z}mierczak-Ba{\l}ata}, Anna and {Garc{\'i}a-Fern{\'a}ndez}, Javier and Bazioti, Calliope and Azarov, Alexander and Park, Ji-Hyeon and Jeon, Dae-Woo and Lee, Halin and Lee, Won-Jae and Zhu, Rui and Mei, Zengxia and Prytz, {\O}ystein and Kuznetsov, Andrej},
  year = 2024,
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2412.13987},
  urldate = {2026-05-16},
  abstract = {Gallium oxide is a novel advanced material gaining increasing attention for its unique combination of functional properties. It forms in several phases or polymorphs - {$\alpha$}, {$\beta$}, {$\gamma$}, and {$\kappa$} - having variable properties because of different lattice symmetries. Optical properties are of particular importance as they determine specific device applications and can also be used for phase identification. However, a direct comparison of optical polymorph signatures, including such critical parameters as bandgaps, is challenging due to the scattered, limited, or even absent data for certain phases in the literature. To address this issue, in the present work we systematically cross-correlate optical emission and absorption features of {$\alpha$}, {$\beta$}, {$\gamma$}, and {$\kappa$} thin films, as well as differently oriented {$\beta$}-phase bulk crystals and {$\gamma$}/{$\beta$} double polymorph structures. We demonstrate that the optical bandgap and emission features scale consistently across these polymorphs upon minimization of the methodological uncertainties. As a result, this work provides a comparative library of near- and far-field optical signatures of the polymorphs for use by the multidisciplinary research community working with gallium oxide.},
  copyright = {Creative Commons Attribution Non Commercial No Derivatives 4.0 International},
  langid = {english},
  keywords = {FOS: Physical sciences,Materials Science (cond-mat.mtrl-sci)}
}

@article{klevtsov_nonlinear_2024,
  title = {Non-Linear Effects in {$\alpha$}-{{Ga2O3}} Radiation Phenomena},
  author = {Klevtsov, Anton and Karaseov, Platon and Azarov, Alexander and Karabeshkin, Konstantin and Fedorenko, Elizaveta and Titov, Andrei and Kuznetsov, Andrej},
  year = 2024,
  month = nov,
  journal = {APL Mater.},
  volume = {12},
  number = {11},
  pages = {111121},
  issn = {2166-532X},
  doi = {10.1063/5.0235497},
  urldate = {2026-05-16},
  abstract = {The rhombohedral phase of gallium oxide ({$\alpha$}-Ga2O3) is of interest because of its highest bandgap among the rest of the Ga2O3 polymorphs, making it particularly attractive in applications. However, even though the ion beam processing is routinely used in device technology, the understanding of radiation phenomena in {$\alpha$}-Ga2O3 is not mature. Here, we study non-linear effects for radiation disorder formation in {$\alpha$}-Ga2O3 by varying both the defect generation rate and the density of collision cascades, enabled by comparing monoatomic and cluster ion implants, also applying systematic variations of ion fluxes. In particular, we show that the collision cascade density governs the surface amorphization rates, also affected by the ion flux variations. These trends are explained in terms of the non-linear in-cascade and inter-cascade defect interactions occurring during ballistic and dynamic defect annealing stages. As such, these data reveal new physics of the radiation phenomena in {$\alpha$}-Ga2O3 and may be applicable for more predictive ion beam processing of {$\alpha$}-Ga2O3-based devices.},
  langid = {english},
  annotation = {Citations: 10 (Crossref) [2026-05-16]\\
Citations: 6 (SemanticScholar) [2026-05-16]}
}

@misc{liu_band_2024,
  title = {Band Offsets at {$\beta$}/{$\gamma$}-\$\textbackslash mathrm\textbraceleft{{Ga}}\textbraceright\_\textbraceleft 2\textbraceright\textbackslash mathrm\textbraceleft{{O}}\textbraceright\_\textbraceleft 3\textbraceright\$ Interface},
  author = {Liu, Huan and Makkonen, Ilja and Bazioti, Calliope and Zhao, Junlei and Azarov, Alexander and Kuznetsov, Andrej and Djurabekova, Flyura},
  year = 2024,
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2412.07576},
  urldate = {2026-05-16},
  abstract = {Ultrawide bandgap semiconductor gallium oxide (Ga2O3) and its polymorphs have recently attracted increasing attention across physics, materials science, and electronics communities. In particular, the self-organized formation of the beta/gamma-Ga2O3 double polymorph structures was demonstrated recently [A. Azarov et al., Nat. Commun. 14, 4855 (2023)], paving the way for prospective applications of such structures in electronics. Consequently, determining the conduction band offset in such structures is crucial since it dictates the behavior of conduction electrons at the interface and, consequently, the potential functionality of such interfaces. Thus, in this work, we calculate the band offsets at the beta/gamma-Ga2O3 interface using density functional theory in correlation with the data provided by the experimental atomistic interface analysis. Specifically, to unravel the strain state of the beta/gamma-Ga2O3 interface, nanoscale strain maps were recorded using high-resolution transmission electron microscopy. In its turn, theoretically, lineup potential and vacuum alignment methods were used to analyze the band offsets, with and without strain, at the beta/gamma-Ga2O3 interface. Altogether, the collected results suggest that the band offsets between the beta and gamma phases are likely not exceeding a few hundred meV, remaining highly sensitive to the strain state at the interface. At this end, we conclude that even though the formation of a two-dimensional electron gas (2DEG) at the beta/gamma interface is theoretically possible, the gradual strain relaxation--if it occurs as a function of the distance from the interface--poses a significant challenge, as it may shift the 2DEG localization or even reduce the overall probability of its formation.},
  copyright = {Creative Commons Attribution Non Commercial No Derivatives 4.0 International},
  langid = {english},
  keywords = {FOS: Physical sciences,Materials Science (cond-mat.mtrl-sci)}
}

@article{titov_density_2025,
  title = {Density and Fractality of Collision Cascades in {$\alpha$}-{{Ga2O3}}},
  author = {Titov, Andrei and Klevtsov, Anton and Fedorenko, Elizaveta and Azarov, Alexander and Kuznetsov, Andrej and Karaseov, Platon},
  year = 2025,
  month = oct,
  journal = {Appl. Phys. Lett.},
  volume = {127},
  number = {15},
  pages = {152107},
  issn = {0003-6951, 1077-3118},
  doi = {10.1063/5.0288966},
  urldate = {2026-05-16},
  abstract = {Control over radiation defect generation is essential while applying ion-beam technology to materials. In this work, we study disorder formation in rhombohedral polymorph of gallium oxide ({$\alpha$}-Ga2O3) as a function of the bombarding ion mass. As such, we discriminate the impact of the collision cascades density, specifically its impact on the surface amorphization rates in {$\alpha$}-Ga2O3. Importantly, along with collecting experimental data, we calculated collision cascades parameters using different algorithms based on the binary collision approximation predicting disorder accumulation trends observed in the experiments. Furthermore, we showed that collision cascades in {$\alpha$}-Ga2O3 can be modeled within a fractal geometry framework, correlating fractal dimension with the collision cascade density. These results enhance the understanding of radiation defects in Ga2O3 polymorphs, applicable in the development of the ion beam technology in these interesting materials.},
  langid = {english},
  annotation = {Citations: 1 (Crossref) [2026-05-16]\\
Citations: 1 (SemanticScholar) [2026-05-16]}
}

