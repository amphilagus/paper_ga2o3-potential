	url = {https://pubs.aip.org/jcp/article/153/14/144501/316601/Machine-learning-interatomic-potential-developed},
	doi = {10.1063/5.0027643},
	abstract = {The thermal properties of $\beta$-Ga2O3 can significantly affect the performance and reliability of high-power electronic devices. To date, due to the absence of a reliable interatomic potential, first-principles calculations based on density functional theory (DFT) have been routinely used to probe the thermal properties of $\beta$-Ga2O3. DFT calculations can only tackle small-scale systems due to the huge computational cost, while the thermal transport processes are usually associated with large time and length scales. In this work, we develop a machine learning based Gaussian approximation potential (GAP) for accurately describing the lattice dynamics of perfect crystalline $\beta$-Ga2O3 and accelerating atomic-scale simulations. The GAP model shows excellent convergence, which can faithfully reproduce the DFT potential energy surface at a training data size of 32 000 local atomic environments. The GAP model is then used to predict ground-state lattice parameters, coefficients of thermal expansion, heat capacity, phonon dispersions at 0 K, and anisotropic thermal conductivity of $\beta$-Ga2O3, which are all in excellent agreement with either the DFT results or experiments. The accurate predictions of phonon dispersions and thermal conductivities demonstrate that the GAP model can well describe the harmonic and anharmonic interactions of phonons. Additionally, the successful application of our GAP model to the phonon density of states of a 2500-atom $\beta$-Ga2O3 structure at elevated temperature indicates the strength of machine learning potentials to tackle large-scale atomic systems in long molecular simulations, which would be almost impossible to generate with DFT-based molecular simulations at present.},
	language = {en},
	number = {14},
	urldate = {2025-12-19},
	journal = {J. Chem. Phys.},
	author = {Liu, Yuan-Bin and Yang, Jia-Yue and Xin, Gong-Ming and Liu, Lin-Hua and Cs{\'a}nyi, G{\'a}bor and Cao, Bing-Yang},
	month = sep,
	year = {2020},
	pages = {144501},
	file = {??:/Users/amphilagusgu/Zotero/storage/XB2H3M82/Liu ? - 2020 - Machine learning interatomic potential developed for molecular simulations on thermal properties of.pdf:application/pdf},
}

@article{sun_neuroevolution_2023,
	title = {A neuroevolution potential for predicting the thermal conductivity of {$\alpha$}-{Ga}$_{\textrm{2}}${O}$_{\textrm{3}}$, {$\beta$}-{Ga}$_{\textrm{2}}${O}$_{\textrm{3}}$, and {$\varepsilon$}-{Ga}$_{\textrm{2}}${O}$_{\textrm{3}}$},
	volume = {123},
	issn = {0003-6951, 1077-3118},
	shorttitle = {{NEP} for {LTC} $\beta$/$\alpha$/$\varepsilon$},
	url = {https://pubs.aip.org/apl/article/123/19/192202/2920693/A-neuroevolution-potential-for-predicting-the},
	doi = {10.1063/5.0165320},
	abstract = {Ga2O3 is an ultrawide-bandgap semiconductor with a variety of crystal configurations, which has the potential for a variety of applications, especially in power electronics and ultraviolet optoelectronics. However, there has been no single interatomic potential reported for Ga2O3 polymorphs in terms of molecular dynamics prediction of thermal conductivity. Here, one interatomic potential has been developed based on neural networks, which has the clear advantages of consuming less computational power than density functional theory and has high accuracy in predicting the thermal conductivity of the three polymorphs of Ga2O3. Using the neuroevolution potential, the thermal conductivity values at 300 K have been predicted. Hence, the j[average-a] was 67.2\% that of b-Ga2O3, and the j[average-e] was only 26.4\% that of b-Ga2O3. The possible reasons for the discrepancies in thermal conductivity values in various crystal types and orientations have been explored. As a result, it could be shown that the contribution of low-frequency phonons to thermal conductivity was very significant in Ga2O3, and a unit cell with low symmetry and high atomic number would negatively impact the thermal conductivity of the material. In this work, a scheme has been proposed for accurately predicting the thermal conductivity of Ga2O3 and a relatively accurate value of the thermal conductivity of e-Ga2O3 has been achieved, which could also provide an atomic-scale perspective for the insight into the thermal conductivity differences among a, b, and e-Ga2O3.},
	language = {en},
	number = {19},
	urldate = {2025-12-19},
	journal = {Appl. Phys. Lett.},
	author = {Sun, Zhanpeng and Qi, Zijun and Liang, Kang and Sun, Xiang and Zhang, Zhaofu and Li, Lijie and Wang, Qijun and Zhang, Guoqing and Wu, Gai and Shen, Wei},
	month = oct,
	year = {2023},
	pages = {192202},
	file = {PDF:/Users/amphilagusgu/Zotero/storage/MCIMIZZI/Sun ? - 2023 - A neuroevolution potential for predicting the thermal conductivity of  $\alpha$  ,  $\beta$.pdf:application/pdf},
}

