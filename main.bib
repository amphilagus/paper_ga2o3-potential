@article{xu_thermal_2025,
	title = {Thermal stability of swift heavy ion tracks in \textit{$\beta$}-{Ga2O3} annealed at high temperatures},
	volume = {127},
	issn = {0003-6951, 1077-3118},
	shorttitle = {New track reference},
	url = {https://pubs.aip.org/apl/article/127/15/151903/3367754/Thermal-stability-of-swift-heavy-ion-tracks-in},
	doi = {10.1063/5.0293037},
	abstract = {As an ultra-wide bandgap ( 4.8 eV) semiconductor, b-Ga2O3 is promising for applications in harsh environments. It is extremely resistant to low-energy ions, but is quite susceptible to swift heavy ions (SHIs), e.g., a single SHI can create an amorphous ion track with several nanometers in diameter. The ultra-wide bandgap allows b-Ga2O3-based devices to operate inherently at high temperatures, which facilitates defect recovery in the material. This study investigates the thermal stability of SHI tracks in b-Ga2O3 within the temperature range of 473{\textendash}773 K using ex situ transmission electron and atomic force microscopy. It was found that the average diameter and morphology of tracks annealed at 673 K or above undergo a significant change due to recrystallization. Annealing at 773 K reduces the areal track density to approximately 50\%. The activation energy for thermal recovery was determined to be 0.27 6 0.03 eV. These findings provide valuable information for assessing the reliability of b-Ga2O3-based devices intended for operation in harsh environments.},
	language = {en},
	number = {15},
	urldate = {2025-10-31},
	journal = {Appl. Phys. Lett.},
	author = {Xu, Lijun and Zhai, Pengfei and Hu, Peipei and Zhang, Shengxia and Zeng, Jian and Li, Zongzhen and Li, Weixing and Toimil-Molares, Maria Eugenia and Trautmann, Christina and Liu, Jie},
	month = oct,
	year = {2025},
	pages = {151903},
	file = {PDF:/Users/amphilagusgu/Zotero/storage/EQS2C3SK/Xu ? - 2025 - Thermal stability of swift heavy ion tracks in $\beta$ -Ga2O3 annealed at high temperatures.pdf:application/pdf},
}

@article{deng_systematic_2024,
	title = {Systematic softening in universal machine learning interatomic potentials},
	volume = {11},
	issn = {2057-3960},
	shorttitle = {10 is enough for finetuning},
	url = {https://www.nature.com/articles/s41524-024-01500-6},
	doi = {10.1038/s41524-024-01500-6},
	abstract = {Abstract
            Machine learning interatomic potentials (MLIPs) have introduced a new paradigm for atomic simulations. Recent advancements have led to universal MLIPs (uMLIPs) that are pre-trained on diverse datasets, providing opportunities for universal force fields and foundational machine learning models. However, their performance in extrapolating to out-of-distribution complex atomic environments remains unclear. In this study, we highlight a consistent potential energy surface (PES) softening effect in three uMLIPs: M3GNet, CHGNet, and MACE-MP-0, which is characterized by energy and force underprediction in atomic-modeling benchmarks including surfaces, defects, solid-solution energetics, ion migration barriers, phonon vibration modes, and general high-energy states. The PES softening behavior originates primarily from the systematically underpredicted PES curvature, which derives from the biased sampling of near-equilibrium atomic arrangements in uMLIP pre-training datasets. Our findings suggest that a considerable fraction of uMLIP errors are highly systematic, and can therefore be efficiently corrected. We argue for the importance of a comprehensive materials dataset with improved PES sampling for next-generation foundational MLIPs.},
	language = {en},
	number = {1},
	urldate = {2025-11-23},
	journal = {npj Comput. Mater.},
	author = {Deng, Bowen and Choi, Yunyeong and Zhong, Peichen and Riebesell, Janosh and Anand, Shashwat and Li, Zhuohan and Jun, KyuJung and Persson, Kristin A. and Ceder, Gerbrand},
	month = dec,
	year = {2024},
	pages = {9},
	file = {PDF:/Users/amphilagusgu/Zotero/storage/LNW8GFHY/Deng ? - 2025 - Systematic softening in universal machine learning interatomic potentials.pdf:application/pdf},
}


