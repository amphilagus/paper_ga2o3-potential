	file = {PDF:/Users/amphilagusgu/Zotero/storage/5LKNWXBD/Li ? - 2025 - Edge-Dependent Step-Flow Growth Mechanism in $\beta$-Ga2 O3 (100) Facet at the Atomi.pdf:application/pdf},
