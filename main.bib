@misc{wright_acoustic_2025,
  title = {Acoustic Phonon Characteristics of (001) and ($\overline{2}$01) {$\beta$}-{{Ga2O3}} Single Crystals Investigated with Brillouin--Mandelstam Light Scattering Spectroscopy},
  shorttitle = {Sound Velocity},
  author = {Wright, Dylan and Guzman, Erick and Bijoy, Md Sabbir Hossen and Wilson, Richard B. and Mudiyanselage, Dinusha Herath and Fu, Houqiang and Kargar, Fariborz and Balandin, Alexander A.},
  year = 2025,
  month = aug,
  journal = {Appl. Phys. Lett.},
  volume = {127},
  number = {5},
  pages = {052201},
  issn = {0003-6951, 1077-3118},
  doi = {10.1063/5.0284006},
  urldate = {2026-01-15},
  abstract = {We report an investigation of the bulk acoustic phonons of (001) and (2\textasciimacron 01) {$\beta$}-Ga2O3 ultra-wide bandgap single crystals using Brillouin--Mandelstam spectroscopy. Pronounced anisotropy in the acoustic phonon dispersion and velocities was observed across different crystal directions. The measured, polarization-branch averaged, acoustic phonon velocities for the crystallographic directions of interest suggest that the difference in phonon velocities contributes to the anisotropy of the reported thermal conductivity of {$\beta$}-Ga2O3, in addition to possible variations in phonon lifetimes. The obtained information for acoustic phonons can be used for developing accurate theoretical models of phonon scattering and optimization of thermal and electrical transport in this technologically important ultra-wide bandgap semiconductor.},
  langid = {english}
}

